# --- Discord -------------------------------------------------------------
DISCORD_TOKEN=changeme   # new Discord app -> Bot -> Reset Token

# --- LLM (any OpenAI-compatible API) --------------------------------------
LLM_BASE_URL=changeme
LLM_API_KEY=changeme
LLM_MODEL=changeme

# --- Access control ------------------------------------------------------
ADMIN_USER_IDS=
ALLOWED_CHANNEL_IDS=

# --- Misc -----------------------------------------------------------------
TIMEZONE=UTC
DATA_DIR=data

# --- Web search -----------------------------------------------------------
TAVILY_API_KEY=

# --- Optional tuning ------------------------------------------------------
MEMORY_MAX_MESSAGES=20
MEMORY_TOKEN_BUDGET=6000
# conversation memory hygiene
CONVERSATION_MAX_CHARS=2000        # per-message cap stored in history
SUMMARY_MAX_WORDS=200              # rolling summary of older messages
SUMMARY_MODEL=                     # empty = reuse LLM_MODEL (can be a cheaper one)
CONVERSATION_RETENTION_DAYS=90     # raw history + its summaries
MAX_AGENT_ITERATIONS=6
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1200
LLM_REQUEST_TIMEOUT=120
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
SEARCH_RATE_LIMIT_PER_USER_PER_HOUR=20
SEARCH_GUILD_DAILY_CAP=200
SEARCH_CACHE_TTL_SECONDS=600
SEARCH_DISCORD_EMBED_LINKS=
# Slash commands (/status, /memory, /persona, /download) are registered with
# Discord only when SYNC_COMMANDS=1. Discord rate-limits command registration,
# so set this for the boot after you change a COMMAND (cogs/*), then unset it.
# LLM tools (tools/*) never need this: they are sent to the model on every call.
SYNC_COMMANDS=

# --- /download ------------------------------------------------------------
# Where temporary video files land (default: <DATA_DIR>/downloads). Files are
# deleted right after they are uploaded.
DOWNLOAD_DIR=
# Reject downloads larger than this (Discord's non-boosted limit is 20 MB).
DOWNLOAD_MAX_MB=20
# Reject videos longer than this (seconds).
DOWNLOAD_MAX_SECONDS=1200
